# ─── Database ────────────────────────────────────────────────────────────────
# Prisma Postgres (cloud) — sign up at prisma.io/postgres, copy connection string
# Local PostgreSQL alternative documented in TESTING.md appendix
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development          # "development" | "production"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Must be a long, random string in production. Any string works in dev.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRY=7d                 # e.g. 7d, 24h, 60m

# ─── LDAP (TBD-7) ────────────────────────────────────────────────────────────
# Leave blank in dev — auth falls back to existence check (password ignored).
# Set in production to enable real IITJ LDAP credential verification.
LDAP_URL=
LDAP_BASE_DN=dc=iitj,dc=ac,dc=in

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
