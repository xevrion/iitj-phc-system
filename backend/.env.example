# ─── Database ────────────────────────────────────────────────────────────────
# Option A: Prisma Postgres (cloud) — sign up at prisma.io/postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Option B: Local PostgreSQL (no SSL needed)
# DATABASE_URL="postgresql://phc_user:phc_pass@localhost:5432/phc_dev"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development          # "development" | "production"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Must be a long, random string in production. Any string works in dev.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRY=7d                 # e.g. 7d, 24h, 60m

# ─── LDAP (TBD-7) ────────────────────────────────────────────────────────────
# Leave blank in dev — auth falls back to existence check (password ignored).
# Set in production to enable real IITJ LDAP credential verification.
LDAP_URL=
LDAP_BASE_DN=dc=iitj,dc=ac,dc=in

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
